{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/" }
  ],
  "crons": [
    {
      "path": "/api/generate-puzzle",
      "schedule": "05 3 * * *"
    }
  ],
  "functions": {
    "api/generate-puzzle.ts": {
      "includeFiles": "api/words.csv, api/dictionary.json"
    }
  }
}